---
import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    date: string;
    updated?: string;
    author?: string;
    paper?: string;
    abstract?: string;
    area?: 'alignment' | 'economic-impacts' | 'ai-governance';
  };
}

const { frontmatter } = Astro.props;
const base = import.meta.env.BASE_URL;

const areaLabels: Record<string, string> = {
  'alignment': 'Alignment & Control',
  'economic-impacts': 'Economic Impacts',
  'ai-governance': 'AI Governance',
};

const areaLabel = frontmatter.area ? areaLabels[frontmatter.area] : null;

const formatDate = (d: string) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={`${frontmatter.title} | The Canary Institute`} description={frontmatter.description}>
  <article class="blog-post">
    <header class="post-header">
      <div class="post-meta">
        {areaLabel && <span class="area-tag">{areaLabel}</span>}
        {frontmatter.author && <span class="post-author">{frontmatter.author}</span>}
      </div>
      <h1>{frontmatter.title}</h1>
      {frontmatter.paper && (
        <p class="post-paper-link">
          This post accompanies a technical paper:
          {frontmatter.abstract
            ? <><a href={frontmatter.abstract}>abstract & figures</a> · <a href={frontmatter.paper}>PDF</a></>
            : <a href={frontmatter.paper}>{frontmatter.paper}</a>
          }
        </p>
      )}
    </header>

    <hr />

    <div class="post-body">
      <slot />
    </div>

    <aside class="follow-substack" aria-label="Follow Canary on Substack">
      <p class="follow-pitch">Get new Canary essays by email on Substack.</p>
      <a class="follow-cta" href="https://canaryinstitute.substack.com">Follow on Substack &rarr;</a>
    </aside>

    <footer class="post-footer">
      <p class="post-dates">
        Originally posted on <time datetime={frontmatter.date}>{formatDate(frontmatter.date)}</time>
        {frontmatter.updated && (
          <span>
            &ensp;&middot;&ensp;Last updated on <time datetime={frontmatter.updated}>{formatDate(frontmatter.updated)}</time>
          </span>
        )}
      </p>
      <a href={`${base}blog/`}>&larr; Back to all posts</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post-header {
    margin-bottom: 1rem;
  }

  .post-meta {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-light-grey);
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .post-author {
    font-family: var(--font-ui, var(--font-body));
  }

  .area-tag {
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    padding: 0.15rem 0.5rem;
    border-radius: 2px;
  }

  .post-header h1 {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }

  .post-paper-link {
    font-size: 0.85rem;
    color: var(--color-light-grey);
    margin-top: 0.75rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    background: #f4f4f2;
  }

  .post-paper-link a {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .post-body {
    font-size: 1rem;
    line-height: 1.85;
  }

  .post-body :global(h2) {
    margin-top: 2.5rem;
  }

  .post-body :global(h3) {
    margin-top: 2rem;
  }

  .post-body :global(img) {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    margin: 1.5rem 0;
    display: block;
  }

  .post-body :global(figure) {
    margin: 2rem 0;
    padding: 0;
  }

  .post-body :global(figure img) {
    margin: 0;
  }

  .post-body :global(figure p) {
    margin: 0;
  }

  .post-body :global(figcaption) {
    font-family: var(--font-ui);
    font-size: 0.87rem;
    line-height: 1.55;
    color: var(--color-light-grey);
    margin-top: 0.75rem;
    padding: 0 0.25rem;
  }

  .post-body :global(figcaption strong) {
    color: var(--color-dark);
    font-weight: 600;
  }

  .post-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.92rem;
  }

  .post-body :global(thead) {
    background: var(--color-accent);
    color: var(--color-white);
  }

  .post-body :global(th) {
    font-family: var(--font-ui);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.65rem 1rem;
    text-align: left;
  }

  .post-body :global(td) {
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .post-body :global(tbody tr:nth-child(even)) {
    background: #f4f4f2;
  }

  .post-body :global(tbody tr:hover) {
    background: #eceee9;
  }

  .post-body :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    font-style: italic;
  }

  .follow-substack {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .follow-pitch {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-grey);
    margin: 0;
    max-width: 40ch;
  }

  .follow-cta {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    letter-spacing: 0.03em;
    color: var(--color-white);
    background: var(--color-accent);
    border: 1px solid var(--color-accent);
    padding: 0.6rem 1rem;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .follow-cta:hover,
  .follow-cta:focus-visible {
    background: var(--color-dark);
    border-color: var(--color-dark);
    color: var(--color-white);
  }

  .post-footer {
    padding-top: 1rem;
  }

  .post-dates {
    font-size: 0.8rem;
    color: var(--color-light-grey);
    margin-bottom: 1rem;
  }

  .post-footer a {
    font-size: 0.9rem;
    color: var(--color-accent);
  }
</style>
